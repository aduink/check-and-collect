export default "{% block sw_condition_value_content %}\n    <div class=\"sw-condition-line-item sw-condition__condition-value\">\n            <sw-condition-operator-select v-bind=\"{ operators, condition }\"></sw-condition-operator-select>\n\n            <sw-number-field\n                size=\"medium\"\n\n\t\t\t\tid=\"cc-score\"\n\t\t\t\tname=\"cc-score\"\n                v-model=\"isScore\"\n                numberType=\"float\"\n                :step=\"0.1\"\n                :allowEmpty=\"false\"\n                :value=\"2.6\"\n                :min=\"1.0\"\n                :max=\"6.0\">\n                <template #suffix>\n                    <span>Schulnoten von 1.0 - 6.0</span>\n                </template>\n            </sw-number-field>\n\n    </div>\n{% endblock %}\n";