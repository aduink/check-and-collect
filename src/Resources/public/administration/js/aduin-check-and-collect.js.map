export default "{% block sw_condition_value_content %}\r\n    <div class=\"sw-condition-line-item sw-condition__condition-value\">\r\n            <sw-condition-operator-select v-bind=\"{ operators, condition }\"></sw-condition-operator-select>\r\n\r\n            <sw-number-field\r\n                size=\"medium\"\r\n\r\n\t\t\t\tid=\"cc-score\"\r\n\t\t\t\tname=\"cc-score\"\r\n                v-model=\"isScore\"\r\n                numberType=\"float\"\r\n                :step=\"0.1\"\r\n                :allowEmpty=\"false\"\r\n                :value=\"2.6\"\r\n                :min=\"1.0\"\r\n                :max=\"6.0\">\r\n                <template #suffix>\r\n                    <span>Schulnoten von 1.0 - 6.0</span>\r\n                </template>\r\n            </sw-number-field>\r\n\r\n    </div>\r\n{% endblock %}\r\n";