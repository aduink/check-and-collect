export default "{% block sw_condition_value_content %}\r\n<div class=\"sw-condition-line-item sw-condition__condition-value\">\r\n    <sw-condition-operator-select v-bind=\"{ operators, condition }\"></sw-condition-operator-select>\r\n    <sw-single-select name=\"additionalinfo\"\r\n                      id=\"additionalinfo\"\r\n                      size=\"medium\"\r\n                      :options=\"selectValues\"\r\n                      v-model=\"isAdditionalinfo\"\r\n                      class=\"field--main\">\r\n    </sw-single-select>\r\n</div>\r\n{% endblock %}\r\n";