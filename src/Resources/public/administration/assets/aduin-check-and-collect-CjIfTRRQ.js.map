{% block sw_condition_value_content %}
    <div class="sw-condition-line-item sw-condition__condition-value">
        <sw-condition-operator-select v-bind="{ operators, condition }"></sw-condition-operator-select>
        <sw-single-select name="awareness"
                          id="awareness"
                          size="medium"
                          :options="selectValues"
                          v-model:value="isCode"
                          class="field--main">
        </sw-single-select>
    </div>
{% endblock %}
