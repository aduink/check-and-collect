{% block sw_customer_detail_debtor_card %}
    <sw-card class="sw-customer-detail-order" >
        <style>.sw-customer-detail-order{overflow:auto;}</style>
    	<div style="padding:0px;height:600px;">
		<h2>{{ $tc('cc-api-newsolvency-button.introtitle') }}</h2>
        <p>{{ $tc('cc-api-newsolvency-button.intro') }}</p><br />
        <sw-button-process  @click="onSave()" :disabled="isLoading" :square="false" :block="true" :isLoading="isLoading" :processSuccess="false" variant="primary">
            {{ $tc('cc-api-newsolvency-button.button') }}
        </sw-button-process>

        <iframe :src="iframeSrc" width="100%" height="80%" style="border: 0px;" title="Customer"></iframe>
        </div>
    </sw-card>
{% endblock %}
